---
// Chapter 12 — Companion (hub, tab 4 "আমি"). The emotional layer: a gentle check-in, an empathetic
// path when stressed (lowers stakes, never pushes study), and encouragement on a comeback. Presence,
// not productivity. Agent: Companion.
import CatalogLayout from '@layouts/CatalogLayout.astro';
import { url } from '@lib/nav';
import ScreenSection from '@components/ScreenSection.astro';
import PhoneFrame from '@components/PhoneFrame.astro';
import AppShell from '@components/AppShell.astro';
import TopBar from '@components/TopBar.astro';
import BottomNav from '@components/BottomNav.astro';
import CompanionBanner from '@components/CompanionBanner.astro';
import SegmentedControl from '@components/SegmentedControl.astro';
import Card from '@components/Card.astro';
import PrimaryCTA from '@components/PrimaryCTA.astro';
import SecondaryButton from '@components/SecondaryButton.astro';
---
<CatalogLayout slug="companion">
  <ScreenSection
    n={1}
    title="মন-মেজাজ চেক-ইন"
    en="Mood check-in"
    note="পড়ার আগে এক মুহূর্ত — 'আজ কেমন লাগছে?' উত্তর সেশনের টোন ঠিক করে। চাপ নেই, এড়িয়েও যাওয়া যায়।"
    agents="Companion"
  >
    <PhoneFrame caption="চেক-ইন" state="default">
      <AppShell>
        <TopBar slot="top" title="আমি" action="⚙" actionLabel="সেটিংস" />
        <div class="space-y-4">
          <CompanionBanner kind="distress" report={false} avatar="🦉">
            আজ একটু থামি — পড়ার আগে বলো তো, এখন কেমন লাগছে?
          </CompanionBanner>
          <Card class="space-y-3">
            <SegmentedControl
              label="আজকের মন"
              chosen="ok"
              options={[
                { key: 'good', bn: '🙂 ভালো' },
                { key: 'ok', bn: '😐 মোটামুটি' },
                { key: 'low', bn: '😔 চাপে' },
              ]}
            />
            <p class="text-meta text-ink-faint">এটা শুধু আমার জানার জন্য — কোথাও নম্বর হয় না।</p>
          </Card>
        </div>
        <BottomNav slot="bottom" active="me" />
      </AppShell>
    </PhoneFrame>
  </ScreenSection>

  <ScreenSection
    n={2}
    title="চাপে থাকলে"
    en="Stressed path"
    note="চাপ জানালে সঙ্গী পড়া চাপায় না — স্টেক কমায়, বিরতি বা হালকা কিছু দেয়। মানুষ আগে, সিলেবাস পরে।"
    agents="Companion"
  >
    <PhoneFrame caption="সহানুভূতি" state="low-mood">
      <AppShell>
        <TopBar slot="top" title="আমি" action="⚙" />
        <div class="flex h-full flex-col">
          <div class="flex-1 space-y-4">
            <CompanionBanner kind="distress" report={false}>
              চাপ লাগছে শুনে খারাপ লাগল। আজ বড় কিছু না করলেও চলবে — চাইলে শুধু ৫ মিনিট হালকা একটা জিনিস দেখি, নয়তো বিরতি নাও।
            </CompanionBanner>
            <Card class="space-y-2 text-body leading-relaxed text-ink">
              <p>মনে রেখো — এক দিন কম পড়লে কিছু ভেঙে পড়ে না। তোমার স্ট্রিক আমি আগলে রেখেছি।</p>
            </Card>
          </div>
          <div class="space-y-3">
            <PrimaryCTA href="#">৫ মিনিট হালকা কিছু</PrimaryCTA>
            <SecondaryButton variant="text" class="w-full">আজ বিরতি নিই</SecondaryButton>
          </div>
        </div>
      </AppShell>
    </PhoneFrame>
  </ScreenSection>

  <ScreenSection
    n={3}
    title="ফিরে আসার উৎসাহ"
    en="Encouragement"
    note="কঠিন সময়ের পর ফিরলে স্বীকৃতি — অর্জিত, ফাঁপা নয়। উৎসাহ ছাত্রের নিজের প্রচেষ্টাকে আয়না করে।"
    agents="Companion"
  >
    <PhoneFrame caption="উৎসাহ" state="comeback">
      <AppShell>
        <TopBar slot="top" title="আমি" action="⚙" />
        <div class="flex h-full flex-col">
          <div class="flex-1 space-y-4">
            <CompanionBanner kind="affirm" report={false}>
              মন ভালো না থাকা সত্ত্বেও তুমি আজ বসেছ — এটাই আসল শক্তি। ছোট করে শুরু করি, একসাথে।
            </CompanionBanner>
          </div>
          <PrimaryCTA href={url('/c/chooser')}>চলো, একটু পড়ি</PrimaryCTA>
        </div>
      </AppShell>
    </PhoneFrame>
  </ScreenSection>
</CatalogLayout>
