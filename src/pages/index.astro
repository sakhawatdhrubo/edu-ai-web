---
// Gallery landing — entry to all 13 screen-chapters. Not a phone screen itself; it is the catalog
// index the reviewer browses. Mirrors full_app_student_ui_journey.md screen index.
import BaseLayout from '@layouts/BaseLayout.astro';
import { chapters } from '@data/chapters';
import { ALL_TIERS, bnNum } from '@lib/mastery';
import { url } from '@lib/nav';

const hub = chapters.filter((c) => c.mode === 'hub');
const takeover = chapters.filter((c) => c.mode === 'takeover');

// dot uses an explicit class (not bg-${name}) so Tailwind JIT keeps it.
const tokens = [
  { dot: 'bg-primary', bn: 'প্রাইমারি — মূল কাজ' },
  { dot: 'bg-mastery', bn: 'মাস্টারি — শুধু অগ্রগতি' },
  { dot: 'bg-struggle', bn: 'স্ট্রাগল — কখনো লাল নয়' },
  { dot: 'bg-info', bn: 'ইনফো — ব্যাখ্যা/কারণ' },
];
---
<BaseLayout title="edu-ai — শেখার যাত্রা (UI মকআপ)">
  <div class="min-h-full bg-surface text-ink">
    <!-- Hero -->
    <header class="border-b border-border bg-surface-raised">
      <div class="mx-auto max-w-5xl px-4 py-6">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="text-label font-medium text-primary">edu-ai · ফুল-অ্যাপ স্টুডেন্ট UI</p>
            <h1 class="mt-1 text-display font-bold leading-tight text-ink">শেখার যাত্রা</h1>
          </div>
          <button
            data-theme-toggle
            aria-label="থিম বদলাও"
            class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-border text-ink-muted hover:bg-surface-sunken"
          >☾</button>
        </div>
        <p class="mt-3 max-w-2xl text-body leading-relaxed text-ink-muted">
          বাংলা-ফার্স্ট, মোবাইল-ফ্রেন্ডলি AI পদার্থবিজ্ঞান টিউটরের সম্পূর্ণ ছাত্র-অভিজ্ঞতা —
          ১৩টি অধ্যায়, প্রতিটিতে ফোন-আকারের প্রকৃত স্ক্রিন। শান্ত, গেমিফিকেশন-হীন, স্বচ্ছ।
        </p>
        <p class="mt-2 text-meta text-ink-faint">
          ডেমো অধ্যায়: <span class="font-medium text-ink-muted">গতি (Motion)</span> · নমুনা ছাত্র: রিফাত
        </p>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-6">
      <!-- Skill-title ladder legend -->
      <section class="mb-8 rounded-card border border-border bg-surface-raised p-4">
        <h2 class="mb-3 text-label font-semibold text-ink-muted">দক্ষতার ধাপ (ছাত্র কখনো কাঁচা নম্বর দেখে না)</h2>
        <div class="flex flex-wrap items-center gap-2">
          {ALL_TIERS.map((t, i) => (
            <>
              <span
                class:list={[
                  'inline-flex items-center gap-1 rounded-pill px-2.5 py-1 text-label font-semibold',
                  {
                    'bg-surface-sunken text-ink-muted': t.tone === 'faint',
                    'bg-struggle-soft text-struggle': t.tone === 'struggle',
                    'bg-info-soft text-info': t.tone === 'info',
                    'bg-mastery-soft text-mastery': t.tone === 'mastery',
                  },
                ]}
              >
                <span aria-hidden="true">{'◆'.repeat(t.index + 1)}</span>{t.title}
              </span>
              {i < ALL_TIERS.length - 1 && <span class="text-ink-faint" aria-hidden="true">→</span>}
            </>
          ))}
        </div>
        <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
          {tokens.map((tok) => (
            <span class="inline-flex items-center gap-1.5 text-meta text-ink-muted">
              <span class={`h-3 w-3 rounded-full ${tok.dot}`} aria-hidden="true"></span>{tok.bn}
            </span>
          ))}
        </div>
      </section>

      <!-- Everyday (hub) chapters -->
      <h2 class="mb-1 text-h2 font-semibold text-ink">প্রতিদিনের অংশ</h2>
      <p class="mb-3 text-meta text-ink-faint">নিচের ৪টি ট্যাব সবসময় থাকে: পড়া · অগ্রগতি · রিভিশন · আমি</p>
      <div class="mb-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {hub.map((c) => (
          <a
            href={url(`/c/${c.slug}`)}
            class="group flex flex-col rounded-card border border-border bg-surface-raised p-4 transition-colors hover:border-primary hover:bg-primary-soft"
          >
            <div class="flex items-center gap-2">
              <span class="grid h-9 w-9 place-items-center rounded-card bg-surface-sunken text-[18px]" aria-hidden="true">{c.icon}</span>
              <span class="nums text-meta text-ink-faint">অধ্যায় {bnNum(c.num)}</span>
            </div>
            <h3 class="mt-2.5 text-body font-semibold text-ink group-hover:text-primary">{c.bn}</h3>
            <p class="mt-0.5 text-label leading-relaxed text-ink-muted">{c.blurb}</p>
            <span class="mt-2 text-meta text-ink-faint">{bnNum(c.screens)} স্ক্রিন →</span>
          </a>
        ))}
      </div>

      <!-- Full-screen (takeover) chapters -->
      <h2 class="mb-1 text-h2 font-semibold text-ink">পূর্ণ-স্ক্রিন পড়া</h2>
      <p class="mb-3 text-meta text-ink-faint">পড়া, পরীক্ষা, শুরুর যাচাই — মনোযোগ ধরে রাখতে মেনু লুকানো থাকে</p>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {takeover.map((c) => (
          <a
            href={url(`/c/${c.slug}`)}
            class="group flex flex-col rounded-card border border-border bg-surface-raised p-4 transition-colors hover:border-primary hover:bg-primary-soft"
          >
            <div class="flex items-center gap-2">
              <span class="grid h-9 w-9 place-items-center rounded-card bg-surface-sunken text-[18px]" aria-hidden="true">{c.icon}</span>
              <span class="nums text-meta text-ink-faint">অধ্যায় {bnNum(c.num)}</span>
            </div>
            <h3 class="mt-2.5 text-body font-semibold text-ink group-hover:text-primary">{c.bn}</h3>
            <p class="mt-0.5 text-label leading-relaxed text-ink-muted">{c.blurb}</p>
            <span class="mt-2 text-meta text-ink-faint">{bnNum(c.screens)} স্ক্রিন →</span>
          </a>
        ))}
      </div>
    </main>

    <footer class="mx-auto max-w-5xl px-4 py-8 text-meta text-ink-faint">
      edu-ai · ছাত্র UI মকআপ · Astro + Tailwind · ব্লুপ্রিন্ট: full_app_student_ui_journey.md
    </footer>
  </div>
</BaseLayout>
