---
// Gallery chrome around a chapter's screens: header (num/title/blurb), back-to-hub, theme toggle,
// and prev/next chapter nav. The chapter's PhoneFrame screens render in the default slot.
import BaseLayout from './BaseLayout.astro';
import { chapterBySlug, nextChapter, prevChapter } from '@data/chapters';
import { bnNum } from '@lib/mastery';
import { url } from '@lib/nav';
interface Props {
  slug: string;
}
const { slug } = Astro.props;
const ch = chapterBySlug(slug)!;
const next = nextChapter(slug);
const prev = prevChapter(slug);
const modeLabel = ch.mode === 'hub' ? 'প্রতিদিনের অংশ · ৪-ট্যাব' : 'পূর্ণ-স্ক্রিন পড়া';
---
<BaseLayout title={`${ch.num}. ${ch.en} — edu-ai`}>
  <div class="min-h-full bg-surface text-ink">
    <!-- Catalog header (gallery chrome, NOT part of the phone screens) -->
    <header class="border-b border-border bg-surface-raised">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
        <a href={url('/')} class="text-label font-medium text-ink-muted hover:text-ink">← সব অধ্যায়</a>
        <span class="text-ink-faint">/</span>
        <span class="nums text-label text-ink-muted">অধ্যায় {bnNum(ch.num)}</span>
        <span class="ml-auto inline-flex items-center gap-2">
          <span class="rounded-pill bg-surface-sunken px-2.5 py-1 text-meta text-ink-muted">{modeLabel}</span>
          <button
            data-theme-toggle
            aria-label="থিম বদলাও"
            class="grid h-9 w-9 place-items-center rounded-full border border-border text-ink-muted hover:bg-surface-sunken"
          >☾</button>
        </span>
      </div>
      <div class="mx-auto max-w-5xl px-4 pb-4">
        <h1 class="flex items-center gap-2 text-h1 font-bold text-ink">
          <span aria-hidden="true">{ch.icon}</span>{ch.bn}
          <span class="text-label font-normal text-ink-faint">· {ch.en}</span>
        </h1>
        <p class="mt-1 max-w-2xl text-body leading-relaxed text-ink-muted">{ch.blurb}</p>
      </div>
    </header>

    <!-- Screen sections -->
    <main class="mx-auto max-w-5xl px-4 py-6">
      <slot />
    </main>

    <!-- Prev / next chapter -->
    <footer class="border-t border-border bg-surface-raised">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-4">
        {prev ? (
          <a href={url(`/c/${prev.slug}`)} class="flex flex-col text-left">
            <span class="text-meta text-ink-faint">← আগের</span>
            <span class="text-label font-medium text-ink">{prev.icon} {prev.bn}</span>
          </a>
        ) : <span></span>}
        <a href={url('/')} class="rounded-pill bg-surface-sunken px-3 py-1.5 text-label text-ink-muted hover:bg-surface">সব অধ্যায়</a>
        {next ? (
          <a href={url(`/c/${next.slug}`)} class="flex flex-col text-right">
            <span class="text-meta text-ink-faint">পরের →</span>
            <span class="text-label font-medium text-ink">{next.icon} {next.bn}</span>
          </a>
        ) : <span></span>}
      </div>
    </footer>
  </div>
</BaseLayout>
